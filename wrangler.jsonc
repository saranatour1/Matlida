{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The app's Worker. The backend is Convex; this serves the pages and SSR.
  "name": "matlida",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Logs and traces for every request, kept in the dashboard, and Issues,
  // which groups recurring failures (uncaught errors, 5xx, logged errors).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    // Reset-password and verify-email links carry one-time codes in the query.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issues": {
      "enabled": true,
    },
  },
  // Feature flags. Convex asks /api/flags, which reads them here (src/routes/api/flags.ts).
  "flagship": [
    {
      "binding": "NO_PHONE_CALLS_YET",
      "app_id": "3e920fef-5b9e-4d56-9884-561a4f797b3a",
    },
  ],
}
