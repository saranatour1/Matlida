    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "format": "oxfmt",
    "lint": "scripts/no-env-files.sh && pnpm run typecheck && eslint .  --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
